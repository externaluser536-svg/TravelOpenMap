{
  "name": "travelopenmap",
  "version": "0.1.0",
  "private": true,
  "description": "TravelOpenMap — офлайн-дневник путешествий с туманом войны на картах OpenStreetMap",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/verify-offline.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "map:demo": "bash tools/build-demo-map.sh",
    "assets:fonts": "node tools/fetch-map-assets.mjs",
    "cap:sync": "npm run build && npx cap sync && node scripts/configure-native.mjs",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "icons": "node scripts/make-icons.mjs && npx capacitor-assets generate",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.56",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
